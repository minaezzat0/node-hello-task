# Ignore macOS system files
.DS_Store

# Ignore Terraform working directory
terraform/.terraform/

# Ignore Terraform state files
terraform/terraform.tfstate
terraform/terraform.tfstate.*

# Crash log files
terraform/crash.log

# Terraform override files
terraform/override.tf
terraform/override.tf.json
terraform/*_override.tf
terraform/*_override.tf.json

# Optionally ignore tfvars if containing secrets
# terraform/*.tfvars

# Terraform CLI config
terraform/.terraformrc
terraform/terraform.rc
